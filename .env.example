# Public browser IDs — tracking will remain disabled until consent is granted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Server-only Meta Conversions API token.
META_CONVERSIONS_API_ACCESS_TOKEN=replace-with-meta-capi-token

# IndexNow key and a token used only to authorize post-deploy submissions.
INDEXNOW_KEY=replace-with-indexnow-key
INDEXNOW_ADMIN_TOKEN=replace-with-a-long-random-token

# Env
NODE_ENV=development

# BREVO_API_KEY, NEXT_PUBLIC_TURNSTILE_SITE_KEY, and TURNSTILE_SECRET_KEY are used for email sending and CAPTCHA verification respectively. Please replace the placeholders with your actual keys.
BREVO_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Malaika Match estimate emails (sent through Brevo's transactional API).
# Sender must be a verified sender / authenticated domain in Brevo.
BREVO_SENDER_EMAIL=partnerships@rotsi.co.ke
# Where new-lead alerts go (defaults to the site email).
MATCH_TEAM_EMAIL=malaikastudios@rotsi.co.ke
# Set to true to send real Brevo emails from `pnpm dev` (off by default).
BREVO_ENABLE_IN_DEV=true